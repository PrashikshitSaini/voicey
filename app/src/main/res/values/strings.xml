    <string name="live_draft_preview_label">Live draft preview</string>
    <string name="live_draft_preview_helper">Shows a temporary draft while you speak. Voicey sends extra short transcription requests to your configured provider, which may use more data and API quota. Draft text can change, is never pasted, and is cleared when dictation ends.</string>
    <string name="live_draft_preview_confirm_title">Live draft preview</string>
    <string name="live_draft_preview_confirm_message">While you speak, Voicey sends extra short transcription requests to your configured provider. This may use more data and API quota. Draft wording can change and is never pasted.</string>

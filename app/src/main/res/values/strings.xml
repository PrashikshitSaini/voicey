    <string name="live_draft_preview_not_now">Not now</string>
    <string name="learn_corrections_label">Learn every word I correct</string>
    <string name="learn_corrections_helper">After dictation, edit a word normally. Voicey learns it after a short pause and shows a card with Undo.</string>

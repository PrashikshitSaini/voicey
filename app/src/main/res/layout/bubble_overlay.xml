<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="48dp"
    android:background="@drawable/bubble_background"
    android:elevation="8dp">

    <LinearLayout
        android:id="@+id/pill_content"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/bubble_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/bubble_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/pill_tap_to_speak"
            android:textColor="@color/bubble_icon"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center_vertical" />

        <dev.prashikshit.voicey.ui.SpectrumView
            android:id="@+id/bubble_spectrum"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_gravity="center_vertical"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/bubble_discard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/discard_button_background"
            android:contentDescription="@string/discard_dictation"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/live_draft_content"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/live_draft_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bubble_icon"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_draft_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bubble_icon"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
